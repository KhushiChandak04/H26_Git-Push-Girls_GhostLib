# Copy to backend/.env (git-ignored). Never commit real keys.
# Gemma 4 is accessed through the Google AI Studio / Gemini API.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TIMEOUT_SECONDS=120

# Relative paths are resolved from backend/. Default: <repo>/artifacts
# GHOSTLIB_ARTIFACTS_DIR=../artifacts
GHOSTLIB_MAX_SOURCE_FILE_BYTES=1000000
